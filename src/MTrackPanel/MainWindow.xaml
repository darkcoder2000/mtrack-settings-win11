<Window x:Class="MTrackPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MTrackPanel"
        Title="M-Audio M-Track Settings"
        Icon="Assets/app.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="SemiBold">
                    <Run Text="M-Audio" /> <Run Text="{Binding ModelName, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C42B1C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#0F7B0F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Audio settings -->
        <TextBlock Text="Audio" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Sample rate" />
                    <TextBlock Text="Used by Windows audio and ASIO" Style="{StaticResource Caption}" />
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="SampleRateBox"
                          ItemsSource="{Binding SampleRates}"
                          SelectedItem="{Binding SelectedSampleRate}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding CanEdit}"
                          AutomationProperties.Name="Sample rate"
                          VerticalAlignment="Center" />

                <Separator Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,12,0,0" Opacity="0.5" />

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24,12,0">
                    <TextBlock Text="ASIO buffer size" />
                    <TextBlock Text="Smaller = lower latency, larger = fewer dropouts" Style="{StaticResource Caption}" />
                </StackPanel>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BufferSizeBox"
                          ItemsSource="{Binding BufferSizes}"
                          SelectedItem="{Binding SelectedBufferSize}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding CanEdit}"
                          AutomationProperties.Name="ASIO buffer size"
                          VerticalAlignment="Center" Margin="0,24,0,0" />
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="#33C42B1C" BorderBrush="#C42B1C" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Versions -->
        <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Driver package" Margin="0,2" />
                <TextBlock Grid.Column="1" Text="{Binding PackageVersion}" FontWeight="SemiBold" Margin="0,2" />
                <TextBlock Grid.Row="1" Text="Driver" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriverVersion}" FontWeight="SemiBold" Margin="0,2" />
                <TextBlock Grid.Row="2" Text="Firmware" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareVersion}" FontWeight="SemiBold" Margin="0,2" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Windows Sound Settings" Click="SoundSettings_Click" Padding="12,6" />
            <Button Grid.Column="2" Content="Close" Click="Close_Click" Padding="20,6" IsDefault="False" IsCancel="True"
                    Style="{DynamicResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</Window>
